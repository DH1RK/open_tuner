{
	"name": "opentuner-streamdeck",
	"version": "0.1.0",
	"description": "Stream Deck plugin for OpenTuner (DATV receiver software)",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.dh1rk.opentuner\""
	},
	"devDependencies": {
		"@elgato/streamdeck": "^3.0.4",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"rollup": "^4.66.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"ws": "^8.22.0"
	}
}
